# Required — your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model for the main answer column. Default: claude-opus-5
# For faster / cheaper replies use: claude-sonnet-5  (or claude-haiku-4-5)
SIDEBAR_MODEL=claude-opus-5

# Optional — model for the review ("Sidebar") column. Default: same as SIDEBAR_MODEL
SIDEBAR_COACH_MODEL=claude-opus-5
